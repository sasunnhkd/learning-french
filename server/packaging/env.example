# /etc/grammaire-server/env  (root:grammaire, mode 0640)
# Every variable: server/app/src/config.rs. Placeholders in CAPITALS.

# The SQLite file (Laravel's schema). See CUTOVER.md for the first one.
DATABASE_URL=sqlite:/var/lib/grammaire-server/database.sqlite
# Loopback only: nginx is the public entry (packaging/nginx-grammaire.conf).
BIND_ADDR=127.0.0.1:8000
# The one editor password. Empty means every login fails.
EDITOR_PASSWORD=CHANGE_ME_LONG_RANDOM
# The git checkout of the site: export writes src/chapters.json and uploads
# go to public/uploads/ under it.
REPO_ROOT=/srv/grammaire
# Public site URL, used to build upload URLs (no trailing slash needed).
FRONTEND_BASE_URL=https://EXAMPLE.github.io/learning-french
# The site's origin, allowed by CORS in addition to the dev origins.
FRONTEND_ORIGIN=https://EXAMPLE.github.io
# Logins per minute per client IP (nginx passes X-Real-IP); 0 = no limit.
LOGIN_RATE_LIMIT=5
LOG_FORMAT=json
RUST_LOG=info
# Leave IDLE_TIMEOUT_SECS unset on the server: systemd keeps it running.
